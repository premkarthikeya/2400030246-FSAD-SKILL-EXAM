<?xml version="1.0" encoding="UTF-8"?>
<hibernate-configuration>
    <session-factory>

        <!-- JDBC -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/mineops_lite
        </property>

        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">123456789</property>

        <!-- Hibernate -->
        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL8Dialect
        </property>

        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Schema validation -->
        <property name="hibernate.hbm2ddl.auto">update</property>


        <!-- Entity mappings -->
        <mapping class="com.mineops.entity.MineSite"/>
        <mapping class="com.mineops.entity.Equipment"/>
        <mapping class="com.mineops.entity.Worker"/>
        <mapping class="com.mineops.entity.ShiftLog"/>
        <mapping class="com.mineops.entity.ProductionLog"/>
        <mapping class="com.mineops.entity.EquipmentUsage"/>
        <mapping class="com.mineops.entity.SafetyIncident"/>

    </session-factory>
</hibernate-configuration>