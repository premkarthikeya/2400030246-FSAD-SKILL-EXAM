<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="addr1" class="com.klu.student.Address">
        <property name="city" value="Vijayawada"/>
        <property name="state" value="AP"/>
    </bean>

    <bean id="student1" class="com.klu.student.Student">
        <property name="id" value="101"/>
        <property name="name" value="Satish"/>
        <property name="address" ref="addr1"/>
    </bean>

</beans>